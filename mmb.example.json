{
  "schema_version": "mmb-external-gate-config-v1",
  "model_map": "model/model.mmb-map.json",
  "memory": {
    "ram_budget": "12GiB",
    "resident_experts": null,
    "kv_cache": "2GiB",
    "scratch": "1GiB",
    "transport": "shared_memory",
    "lease_timeout_seconds": 120
  },
  "io": {
    "workers": 2,
    "prefetch_queue": 32,
    "integrity": "first_load"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 55321,
    "api_token": null,
    "max_request_bytes": 1048576
  },
  "telemetry": {
    "enabled": true
  },
  "model_memory": {
    "enabled": true,
    "path": "state/model-memory.sqlite3"
  }
}
